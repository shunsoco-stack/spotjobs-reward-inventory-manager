# Private Vercel Blob store connection. New Vercel projects inject BLOB_STORE_ID
# and use short-lived OIDC automatically. The token is only a local/legacy fallback.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Comma-separated, base64url SHA-256 channel IDs allowed to use this personal bridge.
# Keep this server-side. The API intentionally fails closed when it is missing.
SYNC_ALLOWED_CHANNEL_IDS=

# Optional comma-separated extra HTTPS origins. Built-in app production,
# Capacitor localhost and Chrome/Edge extension origins are already supported.
SYNC_ALLOWED_ORIGINS=

# Optional retention in seconds. Default: 7,776,000 (90 days).
SYNC_SNAPSHOT_TTL_SECONDS=7776000
