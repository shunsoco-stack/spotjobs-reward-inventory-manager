{
  "name": "spotjobs-reward-inventory-manager",
  "version": "1.0.0",
  "private": true,
  "description": "SPOTJOBSワーカー向け、報酬と在庫の記録アプリ",
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "dev": "node scripts/prepare-ocr.mjs && next dev --hostname 0.0.0.0 --port 3058",
    "build": "node scripts/prepare-ocr.mjs && next build && node scripts/build-offline.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "preview": "node scripts/preview.mjs",
    "ios:add": "npm run build && cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/inappbrowser": "4.1.0",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "lucide-react": "1.28.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
